# Crucible local environment template. Copy to .env and adjust.
# NO real secrets belong in this file or in .env — production secrets come
# from Secret Manager (ADR-007). Values below are local-compose defaults.

CRUCIBLE_PROFILE=local

# Points at the compose services when running apps on the host.
# Host ports are offset (55432/8100/3100) to avoid colliding with a native
# Postgres or other local projects on the default ports.
DATABASE_URL=postgresql+psycopg://crucible:crucible@localhost:55432/crucible
REDIS_URL=redis://localhost:6379/0

# Object storage (MinIO locally; GCS/S3 in cloud).
# S3_PUBLIC_ENDPOINT_URL is the host a *client* can reach: a presigned URL is
# signed for one specific host, and in compose the API talks to `minio:9000`
# while the browser needs `localhost:9000`. Same value in cloud.
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=crucible-local
S3_ACCESS_KEY=crucible
S3_SECRET_KEY=crucible-local-only

# OIDC (optional; API keys work without it)
# OIDC_ISSUER=
# OIDC_AUDIENCE=
# OIDC_JWKS_URI=

# Real-model gateway (optional; MODEL_BACKEND defaults to "fake" — a
# deterministic offline template, no network call). Set MODEL_BACKEND to
# "openai_compat" to use a real provider through any OpenAI-compatible
# /chat/completions endpoint, e.g. OpenRouter (a free API key, no card,
# from openrouter.ai/keys):
# MODEL_BACKEND=openai_compat
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=poolside/laguna-s-2.1:free
# OPENAI_MODEL_LITE=

# Cross-provider fallback (optional; unset = no fallback wired, an outage on
# the provider above abstains as before). A free tier's daily cap or an
# outage takes down every model on that SAME provider together — OPENAI_MODEL
# and OPENAI_MODEL_LITE above don't protect against that, they're two models
# on one provider. This is a second, INDEPENDENT provider (its own base URL,
# key, and quota) that the router falls back to when the primary provider's
# calls are failing, not just one bad response. Any OpenAI-compatible
# provider works, e.g. Groq (console.groq.com/keys) or Google AI Studio
# (aistudio.google.com/apikey, OpenAI-compatible endpoint):
# FALLBACK_OPENAI_BASE_URL=https://api.groq.com/openai/v1
# FALLBACK_OPENAI_API_KEY=
# FALLBACK_OPENAI_MODEL=

# Telemetry (collector runs in compose; exporters are debug-only in Phase 1).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Build identity — injected by CI/image builds; local dev falls back to
# `git rev-parse` automatically for the /version endpoint.
# GIT_SHA=
# BUILT_AT=

# Web
NEXT_PUBLIC_API_URL=http://localhost:8100
